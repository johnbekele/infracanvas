{
  "name": "@infracanvas/core",
  "version": "0.1.0",
  "description": "Core AWS service definitions and IaC code generators for InfraCanvas",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "reactflow": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "reactflow": {
      "optional": true
    }
  },
  "keywords": [
    "aws",
    "infrastructure",
    "terraform",
    "pulumi",
    "iac",
    "code-generation",
    "visual-designer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/johnbekele/infracanvas.git",
    "directory": "packages/core"
  },
  "author": "johnbekele",
  "license": "MIT"
}
