{
  "name": "@infracanvas/ir-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned JSON Schema for the InfraCanvas architecture IR, and the validator every consumer shares",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": "./schema/architecture-ir.schema.json",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "VERSION"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnbekele/infracanvas.git",
    "directory": "packages/ir-schema"
  },
  "author": "johnbekele",
  "license": "MIT"
}
