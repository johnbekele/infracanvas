{
  "irVersion": "1.0.0",
  "name": "Three tier web application",
  "provider": "aws",
  "region": "eu-west-1",
  "nodes": [
    {
      "id": "vpc-main",
      "kind": "vpc",
      "name": "Main VPC",
      "layout": { "x": 0, "y": 0, "width": 960, "height": 640 },
      "params": {
        "cidrBlock": "10.0.0.0/16",
        "enableDnsHostnames": true,
        "enableDnsSupport": true
      }
    },
    {
      "id": "subnet-public-a",
      "kind": "subnet",
      "name": "Public A",
      "parent": "vpc-main",
      "layout": { "x": 32, "y": 64, "width": 420, "height": 240 },
      "params": {
        "tier": "public",
        "cidrBlock": "10.0.1.0/24",
        "availabilityZone": "eu-west-1a"
      }
    },
    {
      "id": "subnet-private-a",
      "kind": "subnet",
      "name": "Private A",
      "parent": "vpc-main",
      "layout": { "x": 32, "y": 340, "width": 420, "height": 240 },
      "params": {
        "tier": "private",
        "cidrBlock": "10.0.2.0/24",
        "availabilityZone": "eu-west-1a"
      }
    },
    {
      "id": "alb-public",
      "kind": "alb",
      "name": "Public load balancer",
      "parent": "subnet-public-a",
      "layout": { "x": 24, "y": 48 },
      "params": { "scheme": "internet-facing", "idleTimeoutSeconds": 60 }
    },
    {
      "id": "ecs-api",
      "kind": "ecs_service",
      "name": "API service",
      "parent": "subnet-private-a",
      "layout": { "x": 24, "y": 48 },
      "params": { "cpu": 512, "memory": 1024, "desiredCount": 2 }
    },
    {
      "id": "rds-primary",
      "kind": "rds_instance",
      "name": "Primary database",
      "parent": "subnet-private-a",
      "layout": { "x": 232, "y": 48 },
      "params": {
        "engine": "postgres",
        "instanceClass": "db.t3.micro",
        "allocatedStorageGb": 20,
        "multiAz": false,
        "publiclyAccessible": false
      }
    }
  ],
  "edges": [
    {
      "id": "alb-to-api",
      "kind": "routes_to",
      "source": "alb-public",
      "target": "ecs-api",
      "label": "HTTPS"
    },
    {
      "id": "api-to-db",
      "kind": "connects",
      "source": "ecs-api",
      "target": "rds-primary",
      "label": "5432"
    }
  ],
  "presentation": {
    "viewport": { "x": 0, "y": 0, "zoom": 1 }
  }
}
