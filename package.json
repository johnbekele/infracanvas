{
  "name": "infracanvas",
  "version": "0.1.0",
  "private": true,
  "description": "Visual AWS infrastructure designer with GitHub integration for GitOps workflows",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnbekele/infracanvas.git"
  },
  "author": "johnbekele",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/ci/verify-local.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "lefthook install || exit 0",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback",
    "db:status": "dbmate --migrations-dir db/migrations status",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "gh:labels": "node scripts/gh/seed-labels.mjs",
    "gh:milestones": "node scripts/gh/seed-milestones.mjs",
    "gh:ruleset": "node scripts/gh/apply-ruleset.mjs",
    "gh:issues": "node scripts/gh/seed-issues.mjs",
    "connector:dev": "node scripts/local-connector.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "lefthook": "^1.10.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "stream-json": "^3.5.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@0.1.12": "0.1.13"
    }
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
