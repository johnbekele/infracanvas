# InfraCanvas API Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Where the GitHub token comes from
#
#   token  Local development and single-user self-hosting. Uses GITHUB_TOKEN if
#          set, otherwise the token the gh CLI already holds. No OAuth app to
#          register, nothing to configure if you have run `gh auth login`.
#
#   oauth  Hosted, multi-user. Each person authorises the app and gets their
#          own token. Requires the two GitHub credentials below.
#
# Defaults to oauth when unset, so a deployment that forgets this gets the
# multi-user flow rather than signing everyone in as the operator.
# =============================================================================
AUTH_PROVIDER=token

# Which method is offered first. Both are available in one process, so setting
# these enables OAuth even while AUTH_PROVIDER is still "token".
# Create a GitHub OAuth App at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Only read by the token method. That method signs the caller in as YOUR
# GitHub account with repo scope, so requests are accepted only from this
# machine. Set this to true solely if every caller that can reach the port is
# trusted with your repository access.
# AUTH_TOKEN_ALLOW_REMOTE=true

# Optional for the token method: use this instead of asking the gh CLI.
# GITHUB_TOKEN=ghp_your_personal_access_token

# Which gh account to ask for, on a machine signed in to more than one. Without
# it gh answers with whichever account its config calls active, and the failure
# is silent: the token is valid and the session is real, so repositories get
# connected as an identity nobody chose. Use the login from `gh auth status`.
# GITHUB_ACCOUNT=your-github-username

# =============================================================================
# Postgres (needs the pgvector extension)
# `docker compose up postgres` starts one on port 5433 that matches this URL.
# =============================================================================
DATABASE_URL=postgres://infracanvas:infracanvas@localhost:5433/infracanvas?sslmode=disable

# =============================================================================
# Security Keys
# Generate with: openssl rand -hex 32
# =============================================================================
ENCRYPTION_KEY=generate_64_hex_characters_here
JWT_SECRET=generate_32_plus_characters_here

# =============================================================================
# URLs
# =============================================================================
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# =============================================================================
# AWS (Optional - for CodeBuild integration)
# =============================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# =============================================================================
# Reverse proxies in front of this process
# Rate limiting counts per client address, so this decides whether
# X-Forwarded-For is believed. Leave it at 0 when running directly; set it to
# the number of proxies when deploying behind one. Too high and a caller can
# choose their own address and evade the limit; too low and everyone shares the
# proxy's bucket.
# =============================================================================
TRUST_PROXY_HOPS=0

# =============================================================================
# The job queue's worker
#
# Analysis runs on the queue rather than inside the request, and this process
# runs the worker by default so one process is a complete installation. Set
# WORKER_ENABLED=false on the instances serving traffic to move jobs onto their
# own instances; leave at least one with it on, or nothing will ever run.
#
# Concurrency is per worker. An analysis is dozens of GitHub requests against one
# user's rate limit, so raising this mostly buys 429s.
# =============================================================================
# WORKER_ENABLED=false
WORKER_CONCURRENCY=2

# =============================================================================
# Optional
# =============================================================================
# GITHUB_WEBHOOK_SECRET=your_webhook_secret
NODE_ENV=development
PORT=3001
