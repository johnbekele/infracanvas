{
  "name": "main branch protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Format" },
          { "context": "Lint and typecheck (TypeScript)" },
          { "context": "Lint and typecheck (Python)" },
          { "context": "Lint (Rust)" },
          { "context": "Forbidden patterns" },
          { "context": "Build" },
          { "context": "Unit tests (TypeScript)" },
          { "context": "Unit tests (Python)" },
          { "context": "Unit tests (Rust)" },
          { "context": "Integration tests" },
          { "context": "Diff coverage" },
          { "context": "Generated types match their schema" },
          { "context": "API client matches the server" },
          { "context": "Migrations are reversible and idempotent" },
          { "context": "Destructive DDL requires approval" },
          { "context": "IR schema changes require a version bump" },
          { "context": "Secret scanning" },
          { "context": "Dependency audit" },
          { "context": "License allowlist" },
          { "context": "Generated IaC policy scan" },
          { "context": "Ingest throughput and memory ceiling" },
          { "context": "Retrieval latency" },
          { "context": "Web bundle size" },
          { "context": "PR hygiene" },
          { "context": "Route by risk tier" }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 5,
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 5,
        "check_response_timeout_minutes": 60,
        "grouping_strategy": "ALLGREEN"
      }
    }
  ],
  "bypass_actors": []
}
